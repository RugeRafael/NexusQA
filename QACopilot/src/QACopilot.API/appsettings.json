{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=NexusQA;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;"
  },
  "JwtSettings": {
    "Issuer": "NexusQA.API",
    "Audience": "NexusQA.Client",
    "ExpirationMinutes": "60"
  },
  "AIService": {
    "BaseUrl": "http://localhost:8000"
  },
  "Jira": {
    "BaseUrl": "https://soporteithealth.atlassian.net",
    "ProjectKey": "SEQ"
  },
  "Security": {
    "MaxFileSizeBytes": 10485760,
    "AllowedDomain": "@ithealth.co",
    "MaxLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*:/api/auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*:/api/auth/register",
        "Period": "1h",
        "Limit": 3
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 60
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "AllowedHosts": "*"
}
